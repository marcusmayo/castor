# Keys and secret material — should never exist here, but belt and suspenders
*.pem
*_key
*_key.pub
# Editor/OS noise
.DS_Store
gate/never-egress.json
# Written on the VM by bootstrap.sh / cloud-init — real secrets, never commit
infra/docker/castor.env
.provision-flags
gate/node_modules/
node_modules/
state/capabilities.json
webchat/node_modules/
*.bak

# Deploy-time name overlay written by cloud-init at provision (fleet-core auth.readAgentName reads it first)
system/agent.local.yaml

# Generated gateway config (bootstrap writes it from system/model-routing.yaml; openrouter.yaml is the committed baseline)
infra/docker/litellm/openrouter.generated.yaml
infra/docker/litellm/openrouter.generated.yaml.tmp
infra/docker/litellm/openrouter.generated.yaml.err
